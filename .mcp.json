{
  "mcpServers": {
    "gmail": {
      "command": "npx",
      "args": ["-y", "@composio/mcp@1.0.9", "--api-key", "YOUR_COMPOSIO_API_KEY"],
      "env": {}
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@0.2.19"],
      "env": {
        "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY"
      }
    },
    "instantly-neverbounce": {
      "command": "npx",
      "args": ["-y", "@composio/mcp@1.0.9", "--api-key", "YOUR_COMPOSIO_API_KEY"],
      "env": {}
    },
    "apollo": {
      "command": "npx",
      "args": ["-y", "@composio/mcp@1.0.9", "--api-key", "YOUR_COMPOSIO_API_KEY"],
      "env": {}
    },
    "apify": {
      "command": "npx",
      "args": ["-y", "@apify/actors-mcp-server@0.10.4"],
      "env": {
        "APIFY_TOKEN": "YOUR_APIFY_TOKEN"
      }
    }
  }
}
