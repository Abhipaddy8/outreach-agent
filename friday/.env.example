# Copy this file to .env and fill in your key.
#   cp .env.example .env

# --- The ONLY paid part: the brain ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model. Default is the most capable. For snappier voice latency you can switch
# to a faster model — that's your call, not a forced downgrade:
#   claude-opus-4-8   (most capable, default)
#   claude-sonnet-4-6 (faster, cheaper, still strong)
#   claude-haiku-4-5  (fastest + cheapest — great for quick voice turns)
JARVIS_MODEL=claude-opus-4-8

# Port the server listens on.
PORT=3000

# --- Optional: natural voice via ElevenLabs (free tier ~10k chars/month) ---
# Leave blank to use the free on-device browser voice. Add a key to switch to a
# natural voice automatically. Get a key at elevenlabs.io → Profile → API key.
ELEVENLABS_API_KEY=
# Voice to use. Default is "Rachel". Browse voices in the ElevenLabs Voice Library
# and paste a Voice ID here to change Friday's voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Model: eleven_turbo_v2_5 is low-latency (good for voice). eleven_multilingual_v2
# sounds richer but is slower.
ELEVENLABS_MODEL=eleven_turbo_v2_5
